id: email-auditor
name: Email Auditor
version: "1.0"
description: Audite et améliore mails bruts en générant 3 variantes contextualisées (DIRECT/PROFESSIONNEL/RELATIONNEL) avec signatures dynamiques. Élimine généricité, renforce clarté, valide strictement.

triggers:
  - "colle un mail brut"
  - "audit ce mail"
  - "améliore ce brouillon"
  - "contexte: client/partenaire/équipe"
  - "envoie ce mail"

workflow:
  - step: "Détection contexte"
    input: "Mail + contexte (client/partenaire/équipe)"
    action: "Analyse destinataire et activité"
    output: "Contexte identifié"
  
  - step: "Audit initial"
    criteria:
      - "Objet (3-7 mots, actionnable)"
      - "Clarté d'attente (qui/quoi/quand)"
      - "Absence généricité (personnalisé)"
      - "Zéro CTA mou (pas de formule molle)"
      - "Signature (contextualisée)"
    output: "Score X/5 + Verdict"
  
  - step: "Restructuration silencieuse"
    rules:
      - "Contexte → enjeu → action"
      - "Supprime redondance"
      - "Raccourcit si >3 paragraphes"
    output: "Mail refondu avec annotations"
  
  - step: "Génération 3 variantes"
    variante_1: "DIRECT (équipe/partenaire)"
    variante_2: "PROFESSIONNEL (partenaire/client B2B)"
    variante_3: "RELATIONNEL (client premium)"
    output: "3 versions + signatures dynamiques"
  
  - step: "Signature dynamique"
    rules:
      - "Client Mister IA → Evrard Mister IA"
      - "Client Devprom → Evrard DEVPROM"
      - "Client Voies d'Égypte → Evrard Voies d'Égypte"
      - "Partenaire → Evrard"
      - "Équipe → Evrard"
      - "Rotaract → Evrard Rotaract"
    output: "Signature appliquée"

writing_profile:
  tone_adaptive:
    - "clients: chaleureux/direct"
    - "partenaires: neutre/efficace"
    - "équipe: direct/assertif"
  
  structure: "Contexte + enjeu + action attendue"
  
  no_fillers: "Zéro et/mais/donc superflus"
  
  closure: "Signature unique dynamique"
  
  subject: "3-7 mots, actionnable"
  
  cta: "Zéro formule molle (n'hésitez pas, dites-moi si, excuses)"

audit_criteria:
  - name: "Objet"
    valid: "3-7 mots, actionnable"
    flag_if: ">10 mots ou vague"
  
  - name: "Clarté d'attente"
    valid: "Qui fait quoi, quand = explicite"
    flag_if: "Ambigu ou on verra"
  
  - name: "Absence généricité"
    valid: "Personnalisé au destinataire"
    flag_if: "Formule template"
  
  - name: "Zéro CTA mou"
    valid: "Pas de dites-moi/n'hésitez pas"
    flag_if: "Présence de phrases molles"
  
  - name: "Signature unique"
    valid: "Correspond au contexte"
    flag_if: "Générique ou absente"

common_pitfalls:
  - piege: "Bonjour à tous"
    detection: "Template générique"
    correction: "Personnaliser au destinataire"
  
  - piege: "N'hésitez pas à..."
    detection: "CTA mou"
    correction: "Envoyez-moi / Confirmez"
  
  - piege: "Cordialement (seul)"
    detection: "Signature faible"
    correction: "Ajouter Evrard [CONTEXTE]"
  
  - piege: "Objet vague"
    detection: "Mail / Demande / Question"
    correction: "Devis devprom - Bordeaux mars 2026"
  
  - piege: "3+ paragraphes contexte"
    detection: "Flou logique"
    correction: "Resserrer à 1-2 phrases"
  
  - piege: "Excuse inutile"
    detection: "Désolé de / Pardon de"
    correction: "Supprimer ou Pour accélérer"
  
  - piege: "CTA à la fin"
    detection: "Après signature"
    correction: "Placer avant signature"
  
  - piege: "Double demande"
    detection: "Et aussi peux-tu"
    correction: "Hiérarchiser action 1/2"

output_format:
  audit: |
    ━━━ AUDIT INITIAL ━━━
    Contexte: [CLIENT / PARTENAIRE / ÉQUIPE]
    
    Objet: [évaluation]
    ├─ Clarté d'attente: [✓ ou ✗]
    ├─ Absence généricité: [✓ ou ✗]
    ├─ CTA mou: [✓ ou ✗]
    ├─ Signature: [✓ ou ✗]
    Score: X/5
    Verdict: [CONFORME / À AMÉLIORER / GÉNÉRIQUE]
  
  restructuration: |
    ━━━ RESTRUCTURATION APPLIQUÉE ━━━
    [mail refondu en ordre logique]
  
  variantes: |
    ━━━ VARIANTE 1 — DIRECT ━━━
    [version courte assertive]
    — Evrard
    
    ━━━ VARIANTE 2 — PROFESSIONNEL ━━━
    [version équilibrée]
    — Evrard [CONTEXTE]
    
    ━━━ VARIANTE 3 — RELATIONNEL ━━━
    [version chaleureux/efficace]
    — Evrard Mister IA / Evrard [CONTEXTE]
  
  notes: |
    ━━━ NOTES ━━━
    - Points forts: [x, y]
    - Améliorations clés: [z, w]
    - Variante recommandée: Variante X (car...)

signature_rules:
  - context: "Client/Prospect"
    signature: "Evrard Mister IA"
    use_case: "Formations, coaching, formation IA"
  
  - context: "Client Devprom"
    signature: "Evrard DEVPROM"
    use_case: "Devis, formations agents, dev foncier"
  
  - context: "Client Voies d'Égypte"
    signature: "Evrard Voies d'Égypte"
    use_case: "Propositions, itinéraires, voyage"
  
  - context: "Partenaire/Fournisseur"
    signature: "Evrard"
    use_case: "Collaboration ponctuelle"
  
  - context: "Équipe/Collaborateur"
    signature: "Evrard"
    use_case: "Interne, instruction"
  
  - context: "Rotaract Paris"
    signature: "Evrard Rotaract"
    use_case: "Commission leadership"

design_notes:
  - "Multimodal: Génère OU améliore OU valide selon besoin"
  - "Hétérogène: Clients/partenaires/équipe dans même compétence"
  - "Scalable: 3 variantes = matrice réutilisable"
  - "Non-invasive: Restructure silencieusement, visible dans output"
  - "Audit strict: Scoring transparent, pas de validation fausse"
  - "Signature contextualisée: Dynamique selon destinataire/activité"

integration_points:
  - "Notion: Draft mail → Lance email-auditor avant envoi"
  - "Make: Workflow formation → email-auditor sur convocations"
  - "Claude in Chrome: Drafts Gmail → Audit avant send"
